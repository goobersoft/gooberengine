' fonts: text() draws with the font in use. Its own fonts/font.g64 makes "a" a solid 5 x 10 block.
cls(0)
text("a", 0, 0, 63)
print("own " + str(pget(0, 0)) + " " + str(pget(4, 9)) + " " + str(pget(5, 0)) + " " + str(font_w()) + "x" + str(font_h()))
flip()
load_font(1, "alt")
swap_font(1)
cls(0)
text("a~na", 0, 0, 63)
print("alt " + str(pget(0, 11)) + " " + str(pget(1, 0)) + " " + str(pget(0, 12)) + " " + str(swap_font()) + " " + str(font_w()) + "x" + str(font_h()) + " " + str(text_width("abc")))
flip()
load_font(1)
cls(0)
text("A", 0, 0, 63)
print("empty " + str(pget(0, 1)) + " " + str(pget(1, 1)) + " " + str(font_w()))
swap_font(0)
swap_font(2)
