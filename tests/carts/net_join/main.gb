' joins tests/carts/net_host: once over TCP, then over UDP
for m = NET_TCP to NET_UDP
    tries = 0
    repeat
        net_join("127.0.0.1", 29200 + m, m)
        while net_status() = NET_CONNECTING : delay(10) : wend
        if net_status() <> NET_CONNECTED then delay(100)
        tries = tries + 1
    until net_status() = NET_CONNECTED or tries > 30
    if net_status() <> NET_CONNECTED then print("net join failed: " + net_error()) : end
    t = 0
    while net_get(0) <> 1234.5 and t < 500 : delay(10) : t = t + 1 : wend
    net_set(1, 777)
    net_send("hi from " + net_id(), 0)
    for i = 1 to 50 : delay(10) : next
    print("net client " + m + ": id " + net_id() + " slot0 " + net_get(0) + " players " + net_peers())
    net_close()
next
