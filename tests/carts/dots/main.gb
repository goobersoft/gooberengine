' the dot limit: pixels a cart may draw per frame
print("limit " + str(dot_limit()))
cls(1)
print("cls " + str(dots_used()))
rect_fill(0, 0, 100, 100, 2)
print("full " + str(dots_used()) + " " + str(pget(0, 0)) + " " + str(pget(99, 99)))
