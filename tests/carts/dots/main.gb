' the dot limit: pixels a cart may draw per frame
print("limit " + str(dot_limit()))
cls(1)
print("cls " + str(dots_used()))
rect_fill(0, 0, 400, 240, 2) : rect_fill(0, 0, 100, 100, 5)
print("full " + str(dots_used()) + " " + str(pget(0, 0)) + " " + str(pget(99, 99)))
flip()
print("flip " + str(dots_used()))
clip(0, 0, 10, 10) : rect_fill(0, 0, 400, 240, 3) : clip()
print("clip " + str(dots_used()))
flip()
dot_limit(5) : cls(4)
print("cls free " + str(dots_used()) + " " + str(pget(399, 239)))
rect_fill(0, 0, 10, 1, 6)
print("small " + str(dots_used()) + " " + str(pget(4, 0)) + " " + str(pget(5, 0)))
' rect_fill_fast is free too, and goes through the camera and clip like rect_fill
flip() : dot_limit(0)
camera(-10, 0) : clip(0, 0, 20, 240)
rect_fill_fast(0, 0, 400, 2, 7)
camera() : clip()
print("fast " + str(dots_used()) + " " + str(pget(9, 0)) + " " + str(pget(10, 0)) + " " + str(pget(19, 1)) + " " + str(pget(20, 0)))
dot_limit(-1)
