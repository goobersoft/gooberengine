' the dot limit: pixels a cart may draw per frame
write("limit " + str(dot_limit()) + "~n")
cls(1)
write("cls " + str(dots_used()) + "~n")
rect_fill(0, 0, 400, 240, 2) : rect_fill(0, 0, 100, 100, 5)
write("full " + str(dots_used()) + " " + str(pget(0, 0)) + " " + str(pget(99, 99)) + "~n")
flip()
write("flip " + str(dots_used()) + "~n")
clip(0, 0, 10, 10) : rect_fill(0, 0, 400, 240, 3) : clip()
write("clip " + str(dots_used()) + "~n")
flip()
dot_limit(5) : cls(4)
write("cls free " + str(dots_used()) + " " + str(pget(399, 239)) + "~n")
rect_fill(0, 0, 10, 1, 6)
write("small " + str(dots_used()) + " " + str(pget(4, 0)) + " " + str(pget(5, 0)) + "~n")
' rect_fill_fast is free too, and goes through the camera and clip like rect_fill
flip() : dot_limit(0)
camera(-10, 0) : clip(0, 0, 20, 240)
rect_fill_fast(0, 0, 400, 2, 7)
camera() : clip()
write("fast " + str(dots_used()) + " " + str(pget(9, 0)) + " " + str(pget(10, 0)) + " " + str(pget(19, 1)) + " " + str(pget(20, 0)) + "~n")
dot_limit(-1)
