' depth buffer, blend modes, spray and textured quads
dot_limit(1000000)       ' this test clears the screen many times in one frame
cls(COL_BLACK)
' blend: each 2-bit channel
c = rgb(2, 1, 0)
set_blend(BLEND_ADD)
plot(0, 0, c)
plot(0, 0, c)
a = pget(0, 0)
set_blend(BLEND_SUB)
plot(0, 0, rgb(1, 3, 0))
s = pget(0, 0)
set_blend(BLEND_MAX)
plot(0, 0, rgb(0, 3, 1))
mx = pget(0, 0)
set_blend(BLEND_MIN)
plot(0, 0, rgb(3, 1, 3))
mn = pget(0, 0)
set_blend(BLEND_XOR)
plot(0, 0, 63)
x = pget(0, 0)
set_blend()
plot(0, 0, 5)
print("blend " + str(a) + " " + str(s) + " " + str(mx) + " " + str(mn) + " " + str(x) + " " + str(pget(0, 0)))

' depth: lower is nearer, equal draws, further is hidden
set_depth(-5)
plot(1, 1, COL_RED)
set_depth(3)
plot(1, 1, COL_BLUE)
d1 = pget(1, 1)
set_depth(-5)
plot(1, 1, COL_GREEN)
d2 = pget(1, 1)
set_depth(-9)
rect_fill(1, 1, 3, 3, COL_YELLOW)
d3 = pget(1, 1)
' cls() clears to the far plane: any depth draws on it
cls(COL_BLACK)
set_depth(100)
plot(1, 1, COL_WHITE)
d4 = pget(1, 1)
set_depth(200)
plot(1, 1, COL_RED)
d5 = pget(1, 1)
' depth 0 pixels count too: they hide what is drawn behind them later
set_depth()
plot(2, 2, COL_GREEN)
set_depth(5)
plot(2, 2, COL_RED)
print("depth " + str(d1 = COL_RED) + " " + str(d2 = COL_GREEN) + " " + str(d3 = COL_YELLOW) + " " + str(d4 = COL_WHITE) + " " + str(d5 = COL_WHITE) + " " + str(pget(2, 2) = COL_GREEN))

' spray: n dots inside the rectangle and nowhere else
cls(COL_BLACK)
seed_rnd(7)
spray(10, 10, 20, 20, 300, COL_RED)
inside = 0
outside = 0
for yy = 0 to 39
    for xx = 0 to 39
        if pget(xx, yy) = COL_RED then
            if xx >= 10 and xx < 30 and yy >= 10 and yy < 30 then
                inside = inside + 1
            else
                outside = outside + 1
            endif
        endif
    next
next
p1 = pget(10, 10)
cls(COL_BLACK)
seed_rnd(7)
spray(10, 10, 20, 20, 300, COL_RED)
again = 0
for yy = 10 to 29
    for xx = 10 to 29
        if pget(xx, yy) = COL_RED then again = again + 1
    next
next
print("spray " + str(inside > 100) + " " + str(outside) + " " + str(again = inside))

' textured quads: tile 0 all color 5, tile 1 all color 9
for yy = 0 to TILE_SIZE - 1
    for xx = 0 to TILE_SIZE - 1
        tile_plot(0, xx, yy, 5)
        tile_plot(1, xx, yy, 9)
    next
next
cls(COL_BLACK)
tex_quad(20, 20, 36, 20, 36, 36, 20, 36, 0, 1, 1)
n = 0
for yy = 16 to 40
    for xx = 16 to 40
        if pget(xx, yy) = 5 then n = n + 1
    next
next
' a trapezoid, no two edges parallel
tex_quad(100, 100, 140, 95, 150, 140, 90, 130, 1, 1, 1)
print("quad " + str(n) + " " + str(pget(120, 115)) + " " + str(pget(80, 80)))

' 3D: the nearer quad wins whichever is drawn first
cls(COL_BLACK)
tex_quad_3d(50, 50, 10, 90, 50, 10, 90, 90, 10, 50, 90, 10, 0, 1, 1)
tex_quad_3d(60, 60, 20, 100, 60, 20, 100, 100, 20, 60, 100, 20, 1, 1, 1)
q1 = pget(70, 70)
cls(COL_BLACK)
tex_quad_3d(60, 60, 20, 100, 60, 20, 100, 100, 20, 60, 100, 20, 1, 1, 1)
tex_quad_3d(50, 50, 10, 90, 50, 10, 90, 90, 10, 50, 90, 10, 0, 1, 1)
q2 = pget(70, 70)
' a tilted quad through a flat one: the left half is in front, the right behind
cls(COL_BLACK)
tex_quad_3d(200, 100, 10, 260, 100, 10, 260, 160, 10, 200, 160, 10, 0, 1, 1)
tex_quad_3d(200, 100, 0, 260, 100, 20, 260, 160, 20, 200, 160, 0, 1, 1, 1)
print("quad3d " + str(q1) + " " + str(q2) + " " + str(pget(205, 130)) + " " + str(pget(255, 130)))
