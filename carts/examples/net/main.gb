' net - up to 8 players move around the same screen, over the network.
' One player hosts, the others join with the host's address (127.0.0.1 is
' this machine, so two GooberEngines side by side can play).
'
' The network commands:
'   net_host(port [, mode])            start a game; you are player 0
'   net_join(address, port [, mode])   join one; net_status() says when you're in
'   net_set(slot, value), net_get(slot)   NET_SLOTS numbers everyone shares
'   net_send(text [, to]), net_recv(), net_from()   messages
'   net_id(), net_peer(id), net_peers(), net_status(), net_error(), net_close()
' mode is NET_TCP (the default) or NET_UDP.
'
' How this game shares things: player p's square is slots p*4 (x) and
' p*4+1 (y), and only player p writes them. The ball is the host's: it moves
' it and writes slots 100-101; everyone else just draws them. B sends a
' wave to everyone as a message.
strict

const PORT:int = 4040
const SIZE:int = 10
const BALL:int = 100               ' slots 100, 101: the ball's x, y

global mode:int = NET_TCP
global address:string = load_data("address", "127.0.0.1")
global x:float, y:float
global bx:float, by:float, bvx:float = 1.5, bvy:float = 1.1
global said:string[NET_MAX_PLAYERS]   ' each player's last wave...
global said_at:int[NET_MAX_PLAYERS]   ' ...and when it came
global colors:int[NET_MAX_PLAYERS]
colors[0] = COL_ORANGE : colors[1] = COL_CYAN : colors[2] = COL_LIME : colors[3] = COL_PINK
colors[4] = COL_YELLOW : colors[5] = COL_PURPLE : colors[6] = COL_RED : colors[7] = COL_SKY

function mode_name:string()
  if mode = NET_UDP then return "UDP"
  return "TCP"
endfunction

' ---- the lobby: pick TCP or UDP, then host or join ----
function lobby()
  repeat
    if key_hit(KEY_T) then mode = NET_TCP + NET_UDP - mode
    ' the address: digits, and C (or space) for a dot
    for local d:int = 0 to 9
      if key_hit(KEY_0 + d) and len(address) < 40 then address = address + d
    next
    if (key_hit(KEY_C) or key_hit(KEY_SPACE)) and len(address) < 40 then address = address + "."
    if key_hit(KEY_BACKSPACE) and len(address) > 0 then address = left(address, len(address) - 1)

    if key_hit(KEY_H)
      if net_host(PORT, mode) then return
    endif
    if key_hit(KEY_J)
      save_data("address", address)
      if net_join(address, PORT, mode)
        while net_status() = NET_CONNECTING
          cls(COL_NAVY)
          text("Joining " + address + " (" + mode_name() + ")...", 20, 110, COL_WHITE)
          flip()
        wend
        if net_status() = NET_CONNECTED then return
      endif
    endif

    cls(COL_NAVY)
    text("NET DEMO", 20, 20, COL_YELLOW)
    text("T     transport: " + mode_name(), 20, 50, COL_WHITE)
    text("H     host a game on port " + PORT, 20, 66, COL_WHITE)
    text("J     join " + address, 20, 82, COL_WHITE)
    text("0-9, C for '.', Backspace: edit the address", 20, 98, COL_GREY)
    if net_error() <> "" then text(net_error(), 20, 130, COL_RED)
    flip()
  forever
endfunction

' ---- the game ----
function play()
  local me:int = net_id()
  x = 40 + me * 40 : y = SCREEN_H / 2
  if me = 0 then bx = SCREEN_W / 2 : by = SCREEN_H / 2

  while net_status() = NET_CONNECTED
    ' move my square, and share where it is
    if btn(BTN_LEFT) then x :- 2
    if btn(BTN_RIGHT) then x :+ 2
    if btn(BTN_UP) then y :- 2
    if btn(BTN_DOWN) then y :+ 2
    x = max(0, min(SCREEN_W - SIZE, x)) : y = max(12, min(SCREEN_H - SIZE, y))
    net_set(me * 4, x)
    net_set(me * 4 + 1, y)
    if btn_hit(BTN_B) then net_send("hi from P" + me) : said[me] = "hi!" : said_at[me] = frame_count()

    ' the host moves the ball; everyone else only reads it
    if net_is_host()
      bx :+ bvx : by :+ bvy
      if bx < 4 or bx > SCREEN_W - 4 then bvx = -bvx
      if by < 16 or by > SCREEN_H - 4 then bvy = -bvy
      net_set(BALL, bx) : net_set(BALL + 1, by)
    endif

    while net_messages() > 0
      local m:string = net_recv()
      said[net_from()] = m : said_at[net_from()] = frame_count()
    wend

    cls(rgb(0, 0, 1))
    circle_fill(int(net_get(BALL)), int(net_get(BALL + 1)), 4, COL_WHITE)
    for local p:int = 0 to NET_MAX_PLAYERS - 1
      if not net_peer(p) then continue
      local px:int = int(net_get(p * 4)), py:int = int(net_get(p * 4 + 1))
      if p = me then px = int(x) : py = int(y)   ' mine: no need to wait for the network
      rect_fill(px, py, SIZE, SIZE, colors[p])
      text("P" + p, px, py - 10, colors[p])
      if said[p] <> "" and frame_count() - said_at[p] < 120 then text(said[p], px + SIZE + 2, py, COL_WHITE)
    next
    rect_fill(0, 0, SCREEN_W, 12, COL_NAVY)
    local who:string = "you are P" + me
    if net_is_host() then who = who + " (host)"
    text(mode_name() + "  " + who + "  players " + net_peers() + "   arrows move  B wave", 4, 1, COL_YELLOW)
    flip()
  wend
endfunction

' the game ends when the host leaves (or the connection is lost): back to
' the lobby, which shows net_error() to say why
repeat
  lobby()
  play()
forever
