' test - a new GooberEngine cart
strict

local x:float = SCREEN_W / 2, y:float = SCREEN_H / 2

repeat
    if btn(BTN_LEFT) then x :- 2 endif
    if btn(BTN_RIGHT) then x :+ 2 endif
    if btn(BTN_UP) then y :- 2 endif
    if btn(BTN_DOWN) then y :+ 2 endif

    cls(COL_NAVY)
    text("hello from test", 8, 8, COL_WHITE)
    circle_fill(x, y, 8, COL_YELLOW)
    flip()
forever
